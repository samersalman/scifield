__pycache__/
*.py[cod]
*.egg-info/
.venv/
.uv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.DS_Store
data/
models/
*.duckdb
*.parquet
/site/
.claude/

# V1-S10 novelty large data artifacts (already covered by data/ above;
# listed explicitly for documentation — these are big binaries kept out of git).
# NOTE: this repo does NOT track .run.json sidecars; the blanket data/ rule
# ignores them too. No !*.run.json negation is used.
data/v1/novelty_semantic.parquet
data/v1/kuzu_graph/
data/v1/kuzu_graph
data/v1/enrichment/cited_by.parquet
data/v1/cd_index.parquet
data/v1/enrichment/cache/cited_by/

# Secrets — never commit. DEEPSEEK_API_KEY etc.
.env
.env.local
.env.*.local

# V2-S11 cartography public deposit — derived tables only (~1.7 MB). See docs/cartography/data-dictionary.md.
# Scoped negation: un-ignores only the small derived parquets under V2/data_v2/** (named data_v2,
# so the `data/` rule above does NOT cover it). The gigabyte raw artifacts live under data/v2/ and
# stay ignored. .DS_Store stays ignored (.DS_Store rule has no negation).
!V2/data_v2/**/*.parquet
